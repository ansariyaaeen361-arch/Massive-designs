# Production env for the analytics.massive-designs.com deployment.
# Copy this to `.env` on the VPS and fill in the two placeholders below —
# everything else is either a fresh production secret (already generated)
# or the exact same account credential you're already using in
# backend/.env locally (copy it over as-is, don't generate a new one).

PORT=4000
NODE_ENV=production

# The subdomain itself — both point at the same place because the backend
# serves the built dashboard directly (see app.js's dashboardDist block).
FRONTEND_URL=https://analytics.massive-designs.com
CLIENT_DASHBOARD_URL=https://analytics.massive-designs.com
PUBLIC_API_URL=https://analytics.massive-designs.com

# Copy this exact value from backend/.env — same dedicated database,
# no migration needed, this just becomes its real production connection.
MONGODB_URI=<copy from backend/.env>

# Copy these exact values from backend/.env (same mailbox, same account)
SMTP_HOST=business145.web-hosting.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@massive-designs.com
SMTP_PASS=<copy from backend/.env>
MAIL_FROM_NAME=Massive Designs
MAIL_FROM_EMAIL=hello@massive-designs.com
MAIL_TO_EMAIL=info@massive-designs.com

# Copy these exact values from backend/.env (same API accounts)
RECAPTCHA_SECRET_KEY=<copy from backend/.env>
GOOGLE_PAGESPEED_API_KEY=<copy from backend/.env>
GEMINI_API_KEY=<copy from backend/.env>

# Generate fresh values for this deployment — never reuse backend/.env's
# (those are this dev session's own secrets) and never commit real values
# here. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate fresh, see comment above>
ADMIN_API_KEY=<generate fresh, see comment above>
